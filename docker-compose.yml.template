services:
  gitea:
    image: gitea/gitea:1.21
    container_name: gitea
    restart: always
    ports:
      - "3000:3000"
      - "2222:22"
    volumes:
      - /opt/devhub/gitea/data:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      - GITEA__server__DOMAIN={{SERVER_IP}}
      - GITEA__server__ROOT_URL=http://{{SERVER_IP}}:3000/
      - GITEA__server__SSH_DOMAIN={{SERVER_IP}}
      - GITEA__server__SSH_PORT=2222

  mosquitto:
    image: eclipse-mosquitto:2
    container_name: mosquitto
    restart: always
    ports:
      - "1883:1883"
    volumes:
      - /opt/devhub/mosquitto/config:/mosquitto/config
      - /opt/devhub/mosquitto/data:/mosquitto/data
      - /opt/devhub/mosquitto/log:/mosquitto/log

  devhub-engine:
    image: devhub-engine:local
    container_name: devhub-engine
    restart: always
    ports:
      - "5050:5050"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /opt/devhub/projects:/opt/devhub/projects
      - /opt/devhub/snapshots:/opt/devhub/snapshots
    environment:
      - SERVER_IP={{SERVER_IP}}
      - LOCAL_IP={{LOCAL_IP}}
